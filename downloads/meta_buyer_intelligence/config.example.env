# Example only. Preserve your existing config.env/.env when already configured.
# Copy this file to config.env ONLY for a new setup. Enter values locally.
# Leave Ads API version unspecified to use the original program default.
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
# META_GRAPH_API_VERSION=
# META_MSG_ACTION=
APP_TOKEN=
# APP_SECRET=  Keep the original value when using existing encrypted data.
PORT=8080
SYNC_INTERVAL_MIN=60
# DB_PATH=  Optional existing database location.

# Incoming chat webhook verification (not a replacement for your Ads token).
META_APP_SECRET=
WEBHOOK_VERIFY_TOKEN=
LINE_CHANNEL_SECRET=

# Flash live API credentials are not configured by this prototype.
# Use the tracking/CSV workflow until an official account adapter is added.
